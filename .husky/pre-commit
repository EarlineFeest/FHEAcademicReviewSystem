#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged
npx lint-staged

# Check for console.log in contracts
echo "Checking for console.log statements in contracts..."
if grep -r "console.log" contracts/ --include="*.sol" 2>/dev/null; then
  echo "❌ Error: Found console.log statements in contracts"
  echo "Please remove console.log before committing"
  exit 1
fi

# Run Solhint
echo "Running Solhint..."
npm run lint:sol || exit 1

# Compile contracts
echo "Compiling contracts..."
npm run compile || exit 1

echo "✅ Pre-commit checks passed!"
