{
  "name": "academic-review-blockchain",
  "version": "1.0.0",
  "description": "Privacy-preserving academic peer review system built with Hardhat and Solidity",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "interact:local": "hardhat run scripts/interact.js --network localhost",
    "interact:sepolia": "hardhat run scripts/interact.js --network sepolia",
    "simulate:local": "hardhat run scripts/simulate.js --network localhost",
    "simulate:sepolia": "hardhat run scripts/simulate.js --network sepolia",
    "clean": "hardhat clean",
    "accounts": "hardhat accounts",
    "help": "hardhat help",
    "lint": "npm run lint:sol && npm run prettier:check",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:fix": "npm run lint:sol:fix && npm run prettier:write",
    "lint:sol:fix": "solhint \"contracts/**/*.sol\" --fix",
    "prettier:check": "prettier --check '**/*.{js,json,md,sol,yml}'",
    "prettier:write": "prettier --write '**/*.{js,json,md,sol,yml}'",
    "format": "npm run prettier:write",
    "frontend:install": "cd frontend && npm install",
    "frontend:start": "cd frontend && npm start",
    "frontend:build": "cd frontend && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "hardhat",
    "solidity",
    "academic-review",
    "peer-review",
    "privacy",
    "fhe"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.2.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.0",
    "typechain": "^8.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.4.0"
  }
}
