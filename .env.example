# ===================================
# Network Configuration
# ===================================

# Sepolia Testnet RPC URL
# Get your API key from: https://www.alchemy.com/ or https://infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Alternative RPC providers:
# Infura: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Public: https://rpc.sepolia.org (not recommended for production)

# ===================================
# Wallet Configuration
# ===================================

# Your wallet private key (without 0x prefix)
# WARNING: Never share or commit this to version control!
# Use a dedicated development wallet, not your main wallet
# Get testnet ETH from: https://sepoliafaucet.com/
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ===================================
# Block Explorer API Keys
# ===================================

# Etherscan API Key for contract verification
# Get your API key from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ===================================
# Gas & Performance Configuration
# ===================================

# Enable gas reporting (true/false)
REPORT_GAS=false

# CoinMarketCap API Key (for gas price reporting in USD)
# Get your API key from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Enable contract size reporting (true/false)
CONTRACT_SIZE=false

# ===================================
# Security Configuration
# ===================================

# OpenZeppelin Defender API credentials
# Get from: https://defender.openzeppelin.com/
DEFENDER_API_KEY=your_defender_api_key_here
DEFENDER_API_SECRET=your_defender_api_secret_here

# ===================================
# Access Control Configuration
# ===================================

# Pauser role address (for emergency pause functionality)
# This address will have the ability to pause contract operations
PAUSER_ADDRESS=0x0000000000000000000000000000000000000000

# Admin role address (for administrative functions)
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Upgrader role address (for contract upgrades if using proxy pattern)
UPGRADER_ADDRESS=0x0000000000000000000000000000000000000000

# ===================================
# Rate Limiting & DoS Protection
# ===================================

# Maximum gas price (in gwei) for transactions
MAX_GAS_PRICE=100

# Maximum transaction timeout (in milliseconds)
TX_TIMEOUT=60000

# Maximum retry attempts for failed transactions
MAX_RETRIES=3

# ===================================
# Monitoring & Alerts
# ===================================

# Codecov token for coverage reporting
# Get from: https://codecov.io/
CODECOV_TOKEN=your_codecov_token_here

# Slack webhook for CI/CD notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===================================
# Development Settings
# ===================================

# Enable verbose logging (true/false)
VERBOSE=false

# CI environment flag (auto-detected in GitHub Actions)
CI=false

# Node environment (development/production/test)
NODE_ENV=development

# ===================================
# Frontend Configuration (if applicable)
# ===================================

# React App Environment
REACT_APP_NETWORK=sepolia
REACT_APP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# API endpoints
REACT_APP_API_URL=https://api.example.com
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ===================================
# Testing Configuration
# ===================================

# Forking configuration for testing
FORK_ENABLED=false
FORK_BLOCK_NUMBER=0
FORK_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ===================================
# Advanced Security Settings
# ===================================

# Enable security checks in tests
SECURITY_CHECKS=true

# Enable reentrancy guard testing
TEST_REENTRANCY=true

# Enable overflow/underflow testing
TEST_ARITHMETIC=true

# ===================================
# Performance Optimization
# ===================================

# Compiler optimization runs (higher = more optimized, slower compilation)
OPTIMIZER_RUNS=200

# Enable via-IR compilation (better optimization, slower compilation)
VIA_IR=true

# Enable metadata hash in bytecode (false = smaller contracts)
METADATA_HASH=false

# ===================================
# Deployment Configuration
# ===================================

# Deployment gas limit
DEPLOYMENT_GAS_LIMIT=12000000

# Deployment gas price multiplier (1.1 = 110% of current gas price)
GAS_PRICE_MULTIPLIER=1.1

# Verify contracts after deployment (true/false)
AUTO_VERIFY=true

# ===================================
# Example Values (DO NOT USE IN PRODUCTION)
# ===================================

# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/abcdef1234567890
# PRIVATE_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# ETHERSCAN_API_KEY=ABCDEFGHIJK1234567890
# COINMARKETCAP_API_KEY=abc123-def456-ghi789
# REPORT_GAS=true
# PAUSER_ADDRESS=0x1234567890123456789012345678901234567890
# ADMIN_ADDRESS=0x1234567890123456789012345678901234567890

# ===================================
# Security Reminders
# ===================================

# 1. NEVER commit .env file to Git
# 2. NEVER share your private key
# 3. Use a dedicated development wallet
# 4. Keep API keys secure
# 5. Regularly rotate API keys
# 6. Use different wallets for testnet and mainnet
# 7. Never use development keys in production
# 8. Enable 2FA on all service accounts
# 9. Use hardware wallets for mainnet deployments
# 10. Audit smart contracts before mainnet deployment

# ===================================
# Getting Started
# ===================================

# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in your actual values
#
# 3. Verify .env is in .gitignore
#
# 4. Test your configuration:
#    npm run compile
#
# 5. Run tests:
#    npm test
#
# 6. Deploy to testnet:
#    npm run deploy:sepolia
